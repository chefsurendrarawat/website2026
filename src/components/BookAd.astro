---
interface Props {
  variant?: 'strip' | 'card'
  poster?: string
}
const { variant = 'strip', poster = '/images/book/poster-1.jpg' } = Astro.props
---
{variant === 'strip' ? (
<a href="/book" class="block book-banner-strip py-4 px-4 sm:px-6">
  <div class="container mx-auto max-w-7xl flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <img src={poster} alt="The Mountain Kitchen Book" class="w-12 h-16 object-cover rounded shadow-lg ring-1 ring-gold-accent/30" loading="lazy" />
      <div>
        <p class="text-gold-accent text-xs font-bold uppercase tracking-wider">New Book Out Now</p>
        <p class="text-white font-serif text-sm sm:text-base font-bold">The Mountain Kitchen</p>
      </div>
    </div>
    <span class="glass-pill text-xs font-bold text-himalayan-blue shrink-0">Buy Now &rarr;</span>
  </div>
</a>
) : (
<a href="/book" class="block group">
  <div class="glass-card rounded-2xl overflow-hidden card-hover">
    <div class="relative h-48 overflow-hidden">
      <img src={poster} alt="The Mountain Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      <span class="absolute bottom-3 left-3 glass-pill text-xs font-bold text-white border-white/30">New Book</span>
    </div>
    <div class="p-4 space-y-1">
      <p class="font-serif font-bold text-himalayan-blue">The Mountain Kitchen</p>
      <p class="text-xs text-slate-600">A Journey from a Himalayan Village to an American Kitchen</p>
    </div>
  </div>
</a>
)}
