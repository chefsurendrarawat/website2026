---
interface Props {
  variant?: 'strip' | 'card'
  poster?: string
}
const { variant = 'strip', poster = '/images/book/poster-1.jpg' } = Astro.props
---
{variant === 'strip' ? (
<a href="/book" class="block book-banner-strip py-5 px-4 sm:px-6">
  <div class="container mx-auto max-w-7xl flex items-center justify-between gap-6">
    <div class="flex items-center gap-5">
      <div class="relative shrink-0">
        <img src={poster} alt="The Mountain Kitchen Book" class="w-16 h-20 sm:w-20 sm:h-28 object-cover rounded-lg shadow-xl ring-2 ring-gold-accent/40" loading="lazy" />
        <div class="absolute -top-1 -right-1 w-5 h-5 bg-gold-accent rounded-full flex items-center justify-center">
          <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
      </div>
      <div class="space-y-1">
        <p class="text-gold-accent text-xs font-bold uppercase tracking-widest">New Book Out Now</p>
        <p class="text-white font-serif text-base sm:text-lg font-bold leading-tight">The Mountain Kitchen</p>
        <p class="text-white/60 text-xs hidden sm:block">A Journey from the Himalayas to an American Kitchen</p>
      </div>
    </div>
    <span class="shrink-0 px-5 py-2.5 bg-gold-accent text-white text-xs sm:text-sm font-bold rounded-full hover:bg-yellow-400 transition-colors shadow-lg">Get Your Copy →</span>
  </div>
</a>
) : (
<a href="/book" class="block group">
  <div class="glass-card rounded-2xl overflow-hidden card-hover">
    <div class="relative h-48 overflow-hidden">
      <img src={poster} alt="The Mountain Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
      <span class="absolute bottom-3 left-3 glass-pill text-xs font-bold text-white border-white/30">New Book</span>
    </div>
    <div class="p-4 space-y-1">
      <p class="font-serif font-bold text-himalayan-blue">The Mountain Kitchen</p>
      <p class="text-xs text-slate-600">A Journey from a Himalayan Village to an American Kitchen</p>
    </div>
  </div>
</a>
)}
