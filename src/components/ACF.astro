---
import { fetchSanity } from '@/lib/sanity'
import { communityDemosQuery } from '@/lib/queries'
import { urlFor } from '@/lib/sanity'

const communityDemos = await fetchSanity(communityDemosQuery) as any[]

const membership = {
  title: "ACF Professional Membership",
  description: "Active member of the American Culinary Federation, the premier professional organization for chefs and cooks in North America",
  validThrough: "June 30, 2026",
  image: "/images/acf-membership-certificate-official.jpg",
}

const spotlight = {
  title: "ACF Chicago Spotlight Member",
  date: "June 2024",
  description: "Featured member recognition by ACF Chicago Chefs for outstanding contributions to the culinary community",
  link: "https://acfchicagochefs.org/Spotlight_Member",
}

const newsletters = [
  { title: "ACF Chicago Newsletter Feature", date: "September 2025", description: "Highlighted in the monthly newsletter celebrating professional achievements", link: "https://acfchicagochefs.org/news.php?=1&id=144" },
  { title: "Professional Recognition Spotlight", date: "August 2025", description: "Featured article showcasing culinary expertise and dedication to the ACF mission", link: "https://acfchicagochefs.org/news.php?=1&id=143" },
  { title: "Community Service Excellence", date: "2025", description: "Recognition for outstanding community cooking demonstrations and educational contributions", link: "https://acfchicagochefs.org/news.php?id=146" },
]

const certifications = [
  { title: "ACF Membership Certificate", date: "Valid through June 30, 2026", image: "/images/acf-membership-certificate-official.jpg" },
  { title: "ACF Chicago Certificate of Appreciation", date: "February 22, 2025", image: "/images/appreciation-20certificate-20acf-20chicago.jpg" },
  { title: "ACF Continuing Education - Exploring Northern India Cuisine", date: "2024", image: "/images/04aa1b85-9d74-4313-a82a-aedb5ca898aa.jpg" },
]

const recipes = [
  { title: "Chicken Tikka", description: "Authentic recipe shared with ACF Chicago Chefs community", link: "https://acfchicagochefs.org/downloads/General/chicken_tikka_recipe_by_chef_surendra_rawat.pdf", image: "/chicken-tikka-grilled-with-chutney-and-garnish.jpg" },
  { title: "Saag Paneer", description: "Traditional North Indian spinach and cottage cheese curry", link: "https://acfchicagochefs.org/downloads/General/saag_paneer_recipe_by_chef_surendra_rawat.pdf", image: "/saag-paneer-spinach-curry-with-cottage-cheese-cube.jpg" },
]

const fallbackDemos = [
  { title: "ESL Community Cooking Workshop", venue: "Faith Lutheran Church, Glen Ellyn", date: "2023 - Current", description: "Teaching ESL students, promoting cultural exchange through food", link: "https://www.faithonline.org/esl-cooking_2023.html", youtubeLink: "https://youtu.be/t_IKJtSiUOY", logo: "/images/logos/faith-lutheran-church.png" },
  { title: "Veggie Fest Chicago Food Demo", venue: "Veggie Fest Chicago", date: "2024", description: "Millet Bread Stuffed with Lentils and Mushrooms — showcasing Himalayan cuisine to thousands", link: "https://veggiefestchicago.org/wp-content/uploads/2025/07/VeggieFest-2025-Food-Demo-Recipe-Surendra-Rahat-Millet-Bread-Stuffed-with-Lentils-and-Mushrooms-NEW.pdf", youtubeLink: "https://youtube.com/shorts/o54eXk_bjHo", logo: "/images/logos/veggie-fest.png" },
  { title: "Professional Culinary Demonstration", venue: "PRC Wheaton", date: "2024", description: "Expert cooking demonstration showcasing professional techniques", link: "#", youtubeLink: "https://youtu.be/SurqvoBi_JM", logo: "/images/logos/peoples-resource-center.png" },
  { title: "No Bake Cheesecake Demonstration", venue: "Carol Stream Public Library", date: "May 16, 2023", description: "Free cooking demonstration showcasing culinary expertise", link: "https://carolstream.librarycalendar.com/event/no-bake-cheesecake-person", youtubeLink: "https://youtu.be/mEEC0GgCA_g", logo: "/images/logos/carol-stream-library.png" },
]

const demos = (communityDemos && communityDemos.length > 0)
  ? communityDemos.map((d: any) => ({
      title: d.title,
      venue: d.venue || "",
      date: d.date || "",
      description: d.description || "",
      link: d.link || "#",
      youtubeLink: d.youtubeLink || "#",
      logo: d.logo ? urlFor(d.logo).width(80).url() : "",
    }))
  : fallbackDemos
---
<section id="acf" class="py-16 md:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#F8E9C6]/20 via-white to-[#F8E9C6]/20">
  <div class="container mx-auto max-w-7xl">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16 space-y-4 animate-fade-in-up">
      <span class="text-sm md:text-base font-bold text-gold-accent uppercase tracking-wider">Professional Excellence</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-gold-accent via-[#FFD700] to-gold-accent bg-clip-text text-transparent">American Culinary Federation</h2>
      <p class="text-lg md:text-xl text-slate-700 max-w-4xl mx-auto leading-relaxed">Active member and recognized contributor to the ACF Chicago Chapter, dedicated to professional excellence, community service, and culinary education</p>
    </div>

    <!-- Spotlight Member Card -->
    <div class="mb-12 md:mb-16">
      <div class="relative bg-gradient-to-br from-[#FFF8E7] via-[#F8E9C6] to-[#FFEAA7] rounded-3xl p-8 md:p-12 shadow-2xl border-2 border-gold-accent/30 card-hover">
        <div class="absolute top-0 left-0 w-24 h-24 border-t-4 border-l-4 border-gold-accent rounded-tl-3xl opacity-50"></div>
        <div class="absolute bottom-0 right-0 w-24 h-24 border-b-4 border-r-4 border-gold-accent rounded-br-3xl opacity-50"></div>
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-8">
          <div class="flex-shrink-0 w-24 h-24 md:w-28 md:h-28 rounded-2xl bg-white flex items-center justify-center shadow-xl ring-4 ring-gold-accent/30 overflow-hidden">
            <img src="/images/acf-logo.png" alt="ACF Logo" class="w-full h-full object-contain p-2" />
          </div>
          <div class="flex-1 text-center md:text-left space-y-4">
            <h3 class="font-serif text-2xl md:text-3xl lg:text-4xl font-bold text-gold-accent">{spotlight.title}</h3>
            <p class="text-lg font-bold text-gold-accent/80">{spotlight.date}</p>
            <p class="text-slate-700 leading-relaxed">{spotlight.description}</p>
            <a href={spotlight.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-gold-accent to-[#FFD700] text-white font-bold rounded-xl shadow-lg hover:shadow-xl hover:scale-105 transition-all">
              View Spotlight Feature
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Newsletters -->
    <div class="mb-12 md:mb-16">
      <h3 class="font-serif text-2xl md:text-3xl font-bold text-gold-accent mb-6 md:mb-8 text-center">ACF Newsletter Features</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
        {newsletters.map(nl => (
          <div class="glass-card card-hover rounded-xl p-6">
            <p class="text-sm text-gold-accent font-bold mb-2">{nl.date}</p>
            <h4 class="font-serif text-lg font-bold text-slate-800 mb-3">{nl.title}</h4>
            <p class="text-sm text-slate-600 mb-4">{nl.description}</p>
            <a href={nl.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-gold-accent font-semibold hover:text-himalayan-blue transition-colors text-sm">
              Read Article
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Certifications -->
    <div class="mb-12 md:mb-16">
      <h3 class="font-serif text-2xl md:text-3xl font-bold text-gold-accent mb-6 md:mb-8 text-center">ACF Certifications & Awards</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {certifications.map(cert => (
          <div class="bg-white rounded-xl overflow-hidden shadow-lg border-2 border-[#F8E9C6] hover:border-gold-accent transition-all card-hover">
            <div class="relative h-48 overflow-hidden bg-[#F8E9C6]/30 img-zoom">
              <img src={cert.image} alt={cert.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="p-4 space-y-2">
              <h4 class="font-serif text-base font-bold text-slate-800">{cert.title}</h4>
              <p class="text-sm text-gold-accent font-semibold">{cert.date}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Recipes -->
    <div class="mb-12 md:mb-16">
      <h3 class="font-serif text-2xl md:text-3xl font-bold text-gold-accent mb-6 md:mb-8 text-center">Recipe Contributions to ACF Community</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {recipes.map(recipe => (
          <div class="bg-gradient-to-br from-white to-[#F8E9C6]/30 rounded-xl p-6 shadow-lg border-2 border-[#F8E9C6] hover:border-gold-accent transition-all card-hover">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-14 h-14 rounded-full overflow-hidden shadow-md border-2 border-gold-accent/30 img-zoom">
                <img src={recipe.image} alt={recipe.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="flex-1">
                <h4 class="font-serif text-lg font-bold text-slate-800 mb-2">{recipe.title}</h4>
                <p class="text-sm text-slate-600 mb-4">{recipe.description}</p>
                <a href={recipe.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-gold-accent font-semibold hover:text-himalayan-blue transition-colors text-sm">
                  Download Recipe PDF
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Community Demonstrations -->
    <div>
      <h3 class="font-serif text-2xl md:text-3xl font-bold text-gold-accent mb-4 text-center">Community Cooking Demonstrations</h3>
      <p class="text-lg text-center text-slate-700 max-w-4xl mx-auto mb-8 leading-relaxed">Dedicated to giving back through free cooking demonstrations, sharing culinary expertise and the joy of cooking</p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 stagger-children">
        {demos.map(demo => (
          <div class="bg-white rounded-xl p-6 shadow-lg border-2 border-[#F8E9C6] hover:border-gold-accent transition-all card-hover">
            <div class="flex items-start gap-3 mb-4">
              {demo.logo && (
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-white border-2 border-gold-accent flex items-center justify-center overflow-hidden">
                  <img src={demo.logo} alt={demo.venue} class="object-contain p-1 w-10 h-10" loading="lazy" />
                </div>
              )}
              <div class="flex-1">
                <h4 class="font-serif text-lg font-bold text-slate-800 mb-1">{demo.title}</h4>
                <p class="text-sm text-gold-accent font-semibold">{demo.venue}</p>
              </div>
            </div>
            <p class="text-xs text-slate-500 mb-2">{demo.date}</p>
            <p class="text-sm text-slate-600 mb-4">{demo.description}</p>
            <div class="flex flex-wrap gap-3">
              {demo.link && demo.link !== "#" && (
                <a href={demo.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-gold-accent font-semibold hover:text-himalayan-blue transition-colors text-sm">
                  Event Details
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              )}
              {demo.youtubeLink && demo.youtubeLink !== "#" && (
                <a href={demo.youtubeLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-gold-accent font-semibold hover:text-himalayan-blue transition-colors text-sm">
                  ▶ Watch Video
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
