---
---
<section id="hero" class="relative min-h-screen flex items-center justify-center pt-20 px-4 sm:px-6 lg:px-8 overflow-hidden bg-gradient-to-br from-sky-50 via-blue-50/80 to-slate-100">
  <!-- Liquid glass blobs -->
  <div class="liquid-blob w-[400px] h-[400px] bg-himalayan-blue/20 top-20 right-10" style="animation-delay: 0s;"></div>
  <div class="liquid-blob w-[500px] h-[500px] bg-sky-blue/30 bottom-10 left-10" style="animation-delay: 2s;"></div>
  <div class="liquid-blob w-[300px] h-[300px] bg-gold-accent/15 top-1/2 left-1/3" style="animation-delay: 4s;"></div>

  <div class="container mx-auto max-w-7xl grid lg:grid-cols-2 gap-8 lg:gap-12 items-center relative z-10">
    <div class="text-center lg:text-left space-y-6 animate-fade-in-up">
      <div class="inline-flex items-center gap-2 px-4 py-2 glass rounded-full">
        <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">Executive Chef | ACF Member</span>
      </div>
      <h2 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-tight">
        <span class="bg-gradient-to-r from-himalayan-blue via-royal-blue to-mountain-teal bg-clip-text text-transparent">Chef Surendra</span>
        <br />
        <span class="text-gold-accent">Rawat</span>
      </h2>
      <p class="text-lg md:text-xl text-slate-700 max-w-lg mx-auto lg:mx-0 leading-relaxed">Bringing Himalayan warmth and 16+ years of culinary artistry to every plate. Customization and personalization through Himalayan artistry.</p>
      <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
        <a href="/recipes" class="px-8 py-4 bg-gradient-to-r from-himalayan-blue to-mountain-teal text-white font-semibold rounded-full shadow-lg hover:shadow-xl transition-all hover:scale-105">Explore My Dishes</a>
        <a href="/contact" class="px-8 py-4 glass border-2 border-himalayan-blue/30 text-himalayan-blue font-semibold rounded-full hover:bg-himalayan-blue hover:text-white hover:border-himalayan-blue transition-all">Get in Touch</a>
      </div>
    </div>
    <div class="relative mx-auto lg:mx-0 w-72 h-72 sm:w-80 sm:h-80 md:w-96 md:h-96 lg:w-[450px] lg:h-[450px]">
      <div class="absolute inset-[-20px] bg-gradient-to-br from-himalayan-blue/20 via-sky-blue/20 to-gold-accent/15 rounded-full blur-3xl animate-float"></div>
      <div class="relative w-full h-full rounded-full overflow-hidden shadow-2xl ring-4 ring-white/50 glass-hero">
        <img src="/chef-surendra-rawat-hero.jpg" alt="Chef Surendra Rawat" class="w-full h-full object-cover" loading="eager" />
      </div>
    </div>
  </div>
</section>
