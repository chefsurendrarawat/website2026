---
import { urlFor } from '@/lib/sanity'
const { items = [] } = Astro.props
---
{items.length > 0 && (
<section id="awards" class="py-16 md:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white via-mist-teal/20 to-white">
  <div class="container mx-auto max-w-7xl">
    <div class="text-center mb-12 md:mb-16 space-y-4">
      <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">Recognition</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-himalayan-blue">Awards & Certifications</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
      {items.map((award: any) => (
        <div class="rounded-xl overflow-hidden glass-card card-hover group">
          {award.image && (
            <div class="relative h-48 overflow-hidden bg-gray-100">
              <img src={urlFor(award.image).width(400).height(300).url()} alt={award.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
          )}
          <div class="p-5 space-y-2">
            <h3 class="font-serif text-lg font-bold text-himalayan-blue leading-tight">{award.title}</h3>
            {award.organization && <p class="text-sm font-semibold text-gold-accent">{award.organization}</p>}
            {award.description && <p class="text-sm text-slate-600">{award.description}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
