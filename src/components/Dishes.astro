---
import { urlFor } from '@/lib/sanity'
const { items = [] } = Astro.props
---
{items.length > 0 && (
<section id="signature-creations" class="py-16 md:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-amber-50/30">
  <div class="container mx-auto max-w-7xl">
    <div class="text-center mb-12 md:mb-16 space-y-4">
      <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">From My Kitchen to Yours</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-himalayan-blue via-royal-blue to-mountain-teal bg-clip-text text-transparent pb-2">Signature Creations</h2>
      <p class="text-lg md:text-xl text-slate-700 max-w-3xl mx-auto leading-relaxed">A curated selection of dishes that define my culinary journey—blending traditional Himalayan ingredients with modern techniques.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {items.map((dish: any) => (
        <details class="group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all card-hover">
          <summary class="cursor-pointer list-none">
            <div class="relative h-64 overflow-hidden">
              {dish.image && <img src={urlFor(dish.image).width(600).height(400).url()} alt={dish.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />}
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <span class="absolute top-3 right-3 px-3 py-1 bg-himalayan-blue text-white text-xs font-semibold rounded-full">{dish.category}</span>
            </div>
            <div class="p-5">
              <h3 class="text-xl font-bold text-gray-800 mb-2">{dish.name}</h3>
              <p class="text-gray-600 text-sm line-clamp-2">{dish.description}</p>
              <p class="mt-3 text-himalayan-blue text-sm font-semibold group-open:hidden">View Recipe &rarr;</p>
              <p class="mt-3 text-himalayan-blue text-sm font-semibold hidden group-open:block">Close &times;</p>
            </div>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 space-y-4">
            <div class="flex flex-wrap gap-4 text-sm text-slate-600">
              {dish.prepTime && <span>&#x23F1; Prep: {dish.prepTime}</span>}
              {dish.cookTime && <span>&#x1F525; Cook: {dish.cookTime}</span>}
              {dish.servings && <span>&#x1F465; {dish.servings}</span>}
              {dish.difficulty && <span>&#x1F4CA; {dish.difficulty}</span>}
            </div>
            {dish.ingredients?.length > 0 && (
              <div>
                <h4 class="font-semibold text-himalayan-blue mb-2">Ingredients</h4>
                <ul class="list-disc list-inside text-sm text-slate-700 space-y-1">
                  {dish.ingredients.map((ing: string) => <li>{ing}</li>)}
                </ul>
              </div>
            )}
            {dish.steps?.length > 0 && (
              <div>
                <h4 class="font-semibold text-himalayan-blue mb-2">Steps</h4>
                <ol class="list-decimal list-inside text-sm text-slate-700 space-y-2">
                  {dish.steps.map((step: string) => <li>{step}</li>)}
                </ol>
              </div>
            )}
            {dish.chefTip && (
              <div class="bg-gold-accent/10 rounded-lg p-3 border border-gold-accent/20">
                <p class="text-sm text-slate-700"><span class="font-semibold text-gold-accent">Chef's Tip:</span> {dish.chefTip}</p>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
)}
