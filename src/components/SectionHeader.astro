---
interface Props {
  tag: string
  title: string
  description?: string
  align?: 'center' | 'left'
  class?: string
}
const { tag, title, description, align = 'center', class: className = '' } = Astro.props
---
<div class:list={["space-y-4 reveal", align === 'center' ? 'text-center' : '', className]}>
  <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">{tag}</span>
  <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-himalayan-blue">{title}</h2>
  {description && <p class="text-lg md:text-xl text-slate-700 max-w-3xl mx-auto leading-relaxed">{description}</p>}
</div>
