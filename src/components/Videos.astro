---
const { items = [] } = Astro.props

function getYouTubeId(url: string): string | null {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/)
  return match ? match[1] : null
}
---
{items.length > 0 && (
<section id="videos" class="py-16 md:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-sky-50">
  <div class="container mx-auto max-w-7xl">
    <div class="text-center mb-12 md:mb-16 space-y-4">
      <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">Featured In</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-himalayan-blue">Video Publications</h2>
      <p class="text-lg md:text-xl text-mountain-teal max-w-3xl mx-auto leading-relaxed">Cooking demonstrations, interviews, and features across YouTube channels.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((video: any) => {
        const videoId = getYouTubeId(video.youtubeUrl || '')
        return (
          <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all border border-himalayan-blue/10 group">
            {videoId && (
              <div class="relative aspect-video">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                  title={video.title}
                  class="w-full h-full"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            )}
            <div class="p-5 space-y-2">
              <h3 class="font-serif text-lg font-bold text-himalayan-blue leading-tight">{video.title}</h3>
              <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
                {video.channel && <span class="font-medium text-mountain-teal">{video.channel}</span>}
                {video.channel && video.date && <span>•</span>}
                {video.date && <span>{video.date}</span>}
              </div>
              {video.description && <p class="text-sm text-slate-600 line-clamp-2">{video.description}</p>}
            </div>
          </div>
        )
      })}
    </div>
  </div>
</section>
)}
