---
const { settings } = Astro.props
---
<section id="contact" class="py-16 md:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-sky-50 to-white">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-12 md:mb-16 space-y-4">
      <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">Get in Touch</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-himalayan-blue">Contact Chef Surendra</h2>
      <p class="text-lg md:text-xl text-mountain-teal max-w-3xl mx-auto leading-relaxed">Interested in private dining, catering, or culinary collaborations? Let's connect.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-12">
      <form action="https://formspree.io/f/xrpzqeqa" method="POST" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Name</label>
          <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all" />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-slate-700 mb-1">Message</label>
          <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all resize-none"></textarea>
        </div>
        <button type="submit" class="w-full px-8 py-4 bg-gradient-to-r from-himalayan-blue to-mountain-teal text-white font-semibold rounded-lg hover:shadow-lg transition-all hover:scale-[1.02]">Send Message</button>
      </form>
      <div class="space-y-8">
        <div class="space-y-4">
          <h3 class="font-serif text-xl font-bold text-himalayan-blue">Contact Information</h3>
          <div class="space-y-4 text-slate-700">
            {settings?.email && <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg><a href={`mailto:${settings.email}`} class="hover:text-himalayan-blue transition-colors">{settings.email}</a></p>}
            {settings?.phone && <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg><a href={`tel:${settings.phone.replace(/\D/g,'')}`} class="hover:text-himalayan-blue transition-colors">{settings.phone}</a></p>}
            {settings?.address && <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>{settings.address}</p>}
            {settings?.restaurantName && <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>{settings.restaurantName}</p>}
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="font-serif text-xl font-bold text-himalayan-blue">Follow Chef Surendra</h3>
          <div class="flex gap-4">
            {settings?.instagram && <a href={settings.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="Instagram"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>}
            {settings?.youtube && <a href={settings.youtube} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="YouTube"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>}
            {settings?.linkedin && <a href={settings.linkedin} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="LinkedIn"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>}
            {settings?.facebook && <a href={settings.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="Facebook"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
