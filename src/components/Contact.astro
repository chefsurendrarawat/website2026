---
const { settings } = Astro.props
---
<section id="contact" class="py-16 md:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-sky-50 to-white">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-12 md:mb-16 space-y-4">
      <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">Get in Touch</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-himalayan-blue">Contact Chef Surendra</h2>
      <p class="text-lg md:text-xl text-mountain-teal max-w-3xl mx-auto leading-relaxed">Interested in private dining, catering, or culinary collaborations? Let's connect.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-12">
      <form action="https://formspree.io/f/xrpzqeqa" method="POST" class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Name</label>
          <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all" />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-slate-700 mb-1">Message</label>
          <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all resize-none"></textarea>
        </div>
        <button type="submit" class="w-full px-8 py-4 bg-gradient-to-r from-himalayan-blue to-mountain-teal text-white font-semibold rounded-lg hover:shadow-lg transition-all hover:scale-[1.02]">Send Message</button>
      </form>
      <div class="space-y-8">
        <div class="space-y-4">
          <h3 class="font-serif text-xl font-bold text-himalayan-blue">Contact Information</h3>
          <div class="space-y-3 text-slate-700">
            {settings?.email && <p>&#x1F4E7; <a href={`mailto:${settings.email}`} class="hover:text-himalayan-blue transition-colors">{settings.email}</a></p>}
            {settings?.phone && <p>&#x1F4DE; <a href={`tel:${settings.phone.replace(/\D/g,'')}`} class="hover:text-himalayan-blue transition-colors">{settings.phone}</a></p>}
            {settings?.address && <p>&#x1F4CD; {settings.address}</p>}
            {settings?.restaurantName && <p>&#x1F37D;&#xFE0F; {settings.restaurantName}</p>}
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="font-serif text-xl font-bold text-himalayan-blue">Follow Chef Surendra</h3>
          <div class="flex gap-4">
            {settings?.instagram && <a href={settings.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="Instagram">&#x1F4F7;</a>}
            {settings?.youtube && <a href={settings.youtube} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="YouTube">&#x25B6;&#xFE0F;</a>}
            {settings?.linkedin && <a href={settings.linkedin} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="LinkedIn">&#x1F4BC;</a>}
            {settings?.facebook && <a href={settings.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="Facebook">&#x1F464;</a>}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
