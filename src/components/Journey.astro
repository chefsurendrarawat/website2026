---
const { items = [] } = Astro.props
const iconMap: Record<string, string> = {
  MapPin: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
  GraduationCap: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>',
  Briefcase: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>',
  Globe: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  Award: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>',
  Compass: '<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9l3 3m0 0l3-3m-3 3v6"/></svg>',
}
const colors = ["from-himalayan-blue to-mountain-teal", "from-mountain-teal to-sky-blue", "from-sky-blue to-peacock-green", "from-peacock-green to-gold-accent", "from-gold-accent to-himalayan-blue"]
---
{items.length > 0 && (
<section id="journey" class="py-16 md:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-sky-50 to-white">
  <div class="container mx-auto max-w-7xl">
    <div class="text-center mb-16 space-y-4 reveal">
      <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">The Path</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-himalayan-blue">My Journey</h2>
      <p class="text-lg md:text-xl text-mountain-teal max-w-3xl mx-auto leading-relaxed">From the mountains to international stages, a story of resilience and never giving up.</p>
    </div>
    <div class="relative">
      <div class="absolute left-1/2 -translate-x-px top-0 bottom-0 w-0.5 bg-gradient-to-b from-himalayan-blue via-gold-accent to-mountain-teal hidden md:block"></div>
      <div class="space-y-12 md:space-y-0">
        {items.map((item: any, i: number) => (
          <div class={`relative md:flex items-center ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} md:mb-16`}>
            <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 w-12 h-12 rounded-full bg-gradient-to-r items-center justify-center text-xl shadow-lg z-10 text-white">
              <div class={`w-12 h-12 rounded-full bg-gradient-to-r ${colors[i % colors.length]} flex items-center justify-center shadow-lg`} set:html={iconMap[item.icon] || iconMap.Compass}>
              </div>
            </div>
            <div class={`md:w-1/2 ${i % 2 === 0 ? 'md:pr-16 md:text-right' : 'md:pl-16'}`}>
              <div class="bg-white rounded-2xl p-6 md:p-8 shadow-lg border border-himalayan-blue/10 hover:shadow-xl transition-shadow">
                <div class={`flex items-center gap-3 mb-3 ${i % 2 === 0 ? 'md:justify-end' : ''}`}>
                  <span class="md:hidden w-6 h-6 text-himalayan-blue" set:html={iconMap[item.icon] || iconMap.Compass}></span>
                  <p class="text-sm font-bold text-gold-accent uppercase tracking-wide">{item.year}</p>
                  <span class="text-xs text-mountain-teal">&bull; {item.location}</span>
                </div>
                <h3 class="font-serif text-xl md:text-2xl font-bold text-himalayan-blue mb-3">{item.title}</h3>
                <p class="text-slate-700 leading-relaxed">{item.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
)}
