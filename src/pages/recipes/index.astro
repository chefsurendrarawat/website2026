---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { fetchSanity, urlFor } from '@/lib/sanity'
import { dishesQuery, siteSettingsQuery } from '@/lib/queries'

const dishes = await fetchSanity(dishesQuery) as any[]
const settings = await fetchSanity(siteSettingsQuery)
---
<Layout title="Himalayan Recipes by Chef Surendra Rawat | Authentic Indian Cuisine" description="Explore authentic Himalayan, Indian, and Nepalese recipes by Chef Surendra Rawat. Traditional Uttarakhand dishes, North Indian classics, and French-inspired desserts." canonical="https://chefsurendrarawat.com/recipes">
  <Header slot="header" />
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"ItemList","name":"Chef Surendra Rawat's Signature Recipes","numberOfItems":dishes.length,"itemListElement":dishes.map((d:any,i:number)=>({"@type":"ListItem","position":i+1,"name":d.name,"description":d.description}))})} />
  </Fragment>

  <section class="py-20 md:py-28 px-4 bg-gradient-to-br from-sky-50 to-white text-center">
    <div class="container mx-auto max-w-4xl space-y-4 reveal">
      <span class="text-sm font-bold text-mountain-teal uppercase tracking-wider">From My Kitchen to Yours</span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold bg-gradient-to-r from-himalayan-blue via-royal-blue to-mountain-teal bg-clip-text text-transparent pb-2">Signature Creations</h1>
      <p class="text-lg text-slate-700 max-w-3xl mx-auto">A curated selection of dishes that define my culinary journey—blending traditional Himalayan ingredients with modern techniques.</p>
    </div>
  </section>

  <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-7xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {dishes.map((dish: any) => (
          <details class="group bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all card-hover">
            <summary class="cursor-pointer list-none">
              <div class="relative h-56 overflow-hidden img-zoom">
                {dish.image && <img src={urlFor(dish.image).width(600).height(400).url()} alt={dish.name} class="w-full h-full object-cover" loading="lazy" />}
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
                <span class="absolute top-3 right-3 px-3 py-1 bg-himalayan-blue text-white text-xs font-semibold rounded-full">{dish.category}</span>
              </div>
              <div class="p-5">
                <h2 class="text-xl font-bold text-gray-800 mb-2">{dish.name}</h2>
                <p class="text-gray-600 text-sm line-clamp-2">{dish.description}</p>
                <div class="flex flex-wrap gap-3 mt-3 text-xs text-slate-500">
                  {dish.prepTime && <span>Prep: {dish.prepTime}</span>}
                  {dish.difficulty && <span class="capitalize">{dish.difficulty}</span>}
                  {dish.servings && <span>{dish.servings}</span>}
                </div>
                <p class="mt-3 text-himalayan-blue text-sm font-semibold group-open:hidden">View Recipe &rarr;</p>
                <p class="mt-3 text-himalayan-blue text-sm font-semibold hidden group-open:block">Close &times;</p>
              </div>
            </summary>
            <div class="px-5 pb-5 border-t border-gray-100 pt-4 space-y-4">
              {dish.ingredients?.length > 0 && (
                <div>
                  <h3 class="font-semibold text-himalayan-blue mb-2">Ingredients</h3>
                  <ul class="list-disc list-inside text-sm text-slate-700 space-y-1">
                    {dish.ingredients.map((ing: string) => <li>{ing}</li>)}
                  </ul>
                </div>
              )}
              {dish.steps?.length > 0 && (
                <div>
                  <h3 class="font-semibold text-himalayan-blue mb-2">Steps</h3>
                  <ol class="list-decimal list-inside text-sm text-slate-700 space-y-2">
                    {dish.steps.map((step: string) => <li>{step}</li>)}
                  </ol>
                </div>
              )}
              {dish.chefTip && (
                <div class="bg-gold-accent/10 rounded-lg p-3 border border-gold-accent/20">
                  <p class="text-sm text-slate-700"><span class="font-semibold text-gold-accent">Chef's Tip:</span> {dish.chefTip}</p>
                </div>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" settings={settings} />
</Layout>
