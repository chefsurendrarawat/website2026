---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { fetchSanity } from '@/lib/sanity'
import { siteSettingsQuery } from '@/lib/queries'
const settings = await fetchSanity(siteSettingsQuery)

const faqs = [
  { q: "What areas do you serve?", a: "I serve the greater Chicago metropolitan area including Wheaton, Naperville, Glen Ellyn, Lombard, and all of DuPage County. For larger events, I'm available throughout Illinois." },
  { q: "How far in advance should I book?", a: "I recommend booking 2-4 weeks in advance for private dining, and 4-6 weeks for larger catering events. Last-minute requests are accommodated when possible." },
  { q: "Do you accommodate dietary restrictions?", a: "Absolutely. I specialize in vegetarian and vegan cuisine, and can accommodate gluten-free, dairy-free, nut allergies, and other dietary needs." },
  { q: "What is the minimum guest count for catering?", a: "There's no minimum for private chef dining experiences. For catering services, I typically serve groups of 20 or more." },
  { q: "Do you offer tasting sessions?", a: "Yes, tasting sessions are available for events of 50+ guests. This helps ensure the menu perfectly matches your vision." },
]
---
<Layout title="Contact Chef Surendra Rawat | Book Private Chef Chicago" description="Book Chef Surendra Rawat for private dining, catering, or cooking classes in Chicago. Contact for quotes and availability." canonical="https://chefsurendrarawat.com/contact">
  <Header slot="header" />

  <section class="py-20 md:py-28 px-4 bg-gradient-to-br from-sky-50 to-white">
    <div class="container mx-auto max-w-7xl">
      <div class="text-center mb-12 space-y-4 reveal">
        <span class="text-sm font-bold text-mountain-teal uppercase tracking-wider">Let's Connect</span>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold text-himalayan-blue">Get in Touch</h1>
        <p class="text-lg text-slate-700 max-w-2xl mx-auto">Interested in private dining, catering, or culinary collaborations? I'd love to hear from you.</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-12">
        <form action="https://formspree.io/f/xrpzqeqa" method="POST" class="space-y-5 glass-card rounded-2xl p-8">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Name *</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email *</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all" />
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">Phone</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all" />
            </div>
            <div>
              <label for="service" class="block text-sm font-medium text-slate-700 mb-1">Service Interest</label>
              <select id="service" name="service" class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all">
                <option value="">Select a service</option>
                <option value="private-dining">Private Dining</option>
                <option value="catering">Catering</option>
                <option value="cooking-class">Cooking Class</option>
                <option value="menu-consultation">Menu Consultation</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-slate-700 mb-1">Message *</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg border border-himalayan-blue/20 focus:border-himalayan-blue focus:ring-2 focus:ring-himalayan-blue/20 outline-none transition-all resize-none"></textarea>
          </div>
          <button type="submit" class="w-full px-8 py-4 bg-gradient-to-r from-himalayan-blue to-mountain-teal text-white font-semibold rounded-lg hover:shadow-lg transition-all hover:scale-[1.02]">Send Message</button>
        </form>

        <div class="space-y-8">
          <div class="space-y-5">
            <h3 class="font-serif text-xl font-bold text-himalayan-blue">Contact Information</h3>
            <div class="space-y-4 text-slate-700">
              <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg><a href="mailto:chefsurendrar@gmail.com" class="hover:text-himalayan-blue transition-colors">chefsurendrar@gmail.com</a></p>
              <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg><a href="tel:+12242615963" class="hover:text-himalayan-blue transition-colors">+1 (224) 261-5963</a></p>
              <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg><a href="https://www.google.com/maps/search/?api=1&query=242+E+Geneva+Rd+Wheaton+IL+60187" target="_blank" rel="noopener noreferrer" class="hover:text-himalayan-blue transition-colors">242 E Geneva Rd, Wheaton IL 60187</a></p>
              <p class="flex items-center gap-3"><svg class="w-5 h-5 text-himalayan-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>India Palace Restaurant</p>
            </div>
          </div>
          <div class="space-y-3">
            <h3 class="font-serif text-xl font-bold text-himalayan-blue">Follow</h3>
            <div class="flex gap-3">
              <a href="https://www.instagram.com/surendrasinghrawat91" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="Instagram"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>
              <a href="https://www.youtube.com/@ChefSurendraRawat" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="YouTube"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
              <a href="https://www.linkedin.com/in/surendra-rawat-834455129" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="LinkedIn"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
              <a href="https://whatsapp.com/channel/0029Va9UQQ44IBh9kJJLwB32" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-himalayan-blue/10 flex items-center justify-center text-himalayan-blue hover:bg-himalayan-blue hover:text-white transition-all" aria-label="WhatsApp"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-sky-50">
    <div class="container mx-auto max-w-3xl">
      <div class="text-center mb-12 reveal">
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-himalayan-blue">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-3">
        {faqs.map(faq => (
          <details class="border border-himalayan-blue/20 rounded-xl overflow-hidden bg-white group">
            <summary class="cursor-pointer list-none px-6 py-5 flex items-center justify-between gap-4 font-medium text-himalayan-blue hover:text-gold-accent transition-colors">
              {faq.q}
              <svg class="w-5 h-5 shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-slate-700 leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" settings={settings} />
</Layout>
