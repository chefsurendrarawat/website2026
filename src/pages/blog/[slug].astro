---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { fetchSanity, urlFor } from '@/lib/sanity'
import { blogPostBySlugQuery, blogSlugsQuery, siteSettingsQuery } from '@/lib/queries'

export async function getStaticPaths() {
  const slugs = await fetchSanity(blogSlugsQuery) as any[]
  return slugs.map(s => ({ params: { slug: s.slug } }))
}

const { slug } = Astro.params
const post = await fetchSanity(blogPostBySlugQuery, { slug }) as any
const settings = await fetchSanity(siteSettingsQuery)

const bodyText = post?.body?.map((block: any) => block._type === 'block' ? block.children?.map((c: any) => c.text).join('') : '').join('\n\n') || ''
const paragraphs = bodyText.split('\n\n').filter((p: string) => p.trim())
---
<Layout title={`${post?.title || 'Blog Post'} | Chef Surendra Rawat`} description={post?.excerpt || 'A blog post by Chef Surendra Rawat'} canonical={`https://chefsurendrarawat.com/blog/${slug}`} type="article">
  <Header slot="header" />

  <article class="py-16 md:py-24 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-3xl">
      <!-- Back link -->
      <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-himalayan-blue hover:text-mountain-teal transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to Blog
      </a>

      <!-- Hero Image -->
      {post?.mainImage && (
        <div class="relative aspect-[16/9] rounded-2xl overflow-hidden mb-8 shadow-xl">
          <img src={urlFor(post.mainImage).width(1200).height(675).url()} alt={post.title} class="w-full h-full object-cover" />
        </div>
      )}

      <!-- Header -->
      <header class="mb-10 reveal">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          {post?.category && (
            <span class="px-3 py-1 bg-himalayan-blue/10 text-himalayan-blue text-xs font-bold rounded-full uppercase tracking-wide">{post.category}</span>
          )}
          {post?.publishedAt && (
            <time class="text-sm text-slate-500" datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
          )}
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-himalayan-blue leading-tight">{post?.title}</h1>
      </header>

      <!-- Body Content -->
      <div class="prose prose-lg max-w-none space-y-6">
        {paragraphs.map((paragraph: string) => (
          <p class="text-slate-700 leading-relaxed text-lg">{paragraph}</p>
        ))}
      </div>

      <!-- Footer nav -->
      <div class="mt-16 pt-8 border-t border-gray-200">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-himalayan-blue hover:text-mountain-teal transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to Blog
        </a>
      </div>
    </div>
  </article>

  <Footer slot="footer" settings={settings} />
</Layout>
