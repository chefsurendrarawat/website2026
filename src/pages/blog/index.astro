---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { fetchSanity, urlFor } from '@/lib/sanity'
import { blogPostsQuery, siteSettingsQuery } from '@/lib/queries'

const posts = await fetchSanity(blogPostsQuery) as any[]
const settings = await fetchSanity(siteSettingsQuery) as any
---
<Layout title="Blog | Chef Surendra Rawat - Culinary Stories & Insights" description="Culinary insights, stories, and recipes from the Himalayas. Chef Surendra Rawat shares behind-the-scenes content, authentic recipes, and his journey." canonical="https://chefsurendrarawat.com/blog">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-ice-blue to-white">
    <div class="container mx-auto max-w-7xl text-center reveal">
      <span class="text-sm md:text-base font-bold text-mountain-teal uppercase tracking-wider">From the Kitchen</span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold text-himalayan-blue mt-3">Chef's Blog</h1>
      <p class="text-lg md:text-xl text-mountain-teal max-w-3xl mx-auto mt-4 leading-relaxed">Culinary insights, stories, and recipes from the Himalayas.</p>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  {posts && posts.length > 0 ? (
  <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children">
        {posts.map((post: any) => (
          <a href={`/blog/${post.slug.current}`} class="block bg-white rounded-xl overflow-hidden shadow-lg border border-himalayan-blue/10 card-hover group">
            {post.mainImage && (
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src={urlFor(post.mainImage).width(600).height(375).url()} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
            )}
            <div class="p-6 space-y-3">
              <div class="flex items-center gap-3">
                {post.category && (
                  <span class="px-3 py-1 bg-himalayan-blue/10 text-himalayan-blue text-xs font-bold rounded-full uppercase tracking-wide">{post.category}</span>
                )}
                {post.publishedAt && (
                  <span class="text-sm text-slate-500">{new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                )}
              </div>
              <h2 class="font-serif text-xl font-bold text-himalayan-blue leading-tight group-hover:text-mountain-teal transition-colors">{post.title}</h2>
              {post.excerpt && <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">{post.excerpt}</p>}
              <span class="inline-flex items-center text-sm font-semibold text-himalayan-blue group-hover:text-mountain-teal transition-colors">
                Read More <span class="ml-1 group-hover:translate-x-1 transition-transform">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  ) : (
  <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-7xl text-center">
      <div class="max-w-2xl mx-auto reveal">
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-ice-blue flex items-center justify-center">
          <svg class="w-10 h-10 text-himalayan-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-himalayan-blue mb-4">Coming Soon</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">Stay tuned for culinary stories, behind-the-scenes content, and authentic Himalayan recipes.</p>
        <div class="flex flex-wrap justify-center gap-3">
          {settings?.instagram && (
            <a href={settings.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-himalayan-blue/10 text-himalayan-blue font-semibold rounded-full hover:bg-himalayan-blue hover:text-white transition-colors text-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              Instagram
            </a>
          )}
          {settings?.youtube && (
            <a href={settings.youtube} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-himalayan-blue/10 text-himalayan-blue font-semibold rounded-full hover:bg-himalayan-blue hover:text-white transition-colors text-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              YouTube
            </a>
          )}
          {settings?.linkedin && (
            <a href={settings.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-himalayan-blue/10 text-himalayan-blue font-semibold rounded-full hover:bg-himalayan-blue hover:text-white transition-colors text-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
  )}

  <Footer slot="footer" settings={settings} />
</Layout>
