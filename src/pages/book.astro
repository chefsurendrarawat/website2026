---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { fetchSanity } from '@/lib/sanity'
import { siteSettingsQuery } from '@/lib/queries'
const settings = await fetchSanity(siteSettingsQuery)

const buyLinks = [
  { name: "Amazon Kindle (US)", url: "https://www.amazon.com/dp/B0H7QYVMPX", icon: "🇺🇸", color: "from-[#FF9900] to-[#E47911]" },
  { name: "Amazon Kindle (India)", url: "https://www.amazon.in/dp/B0H7QYVMPX", icon: "🇮🇳", color: "from-[#FF9900] to-[#E47911]" },
  { name: "StoryMonk (Print)", url: "https://storymonk.co/store/product/the-mountain-kitchen/", icon: "📖", color: "from-himalayan-blue to-mountain-teal" },
]

const posters = [
  "/images/book/poster-1.jpg",
  "/images/book/poster-2.jpg",
  "/images/book/poster-3.jpg",
  "/images/book/poster-4.jpg",
]
---
<Layout title="The Mountain Kitchen | Book by Chef Surendra Rawat — Buy Now" description="Buy The Mountain Kitchen by Chef Surendra Singh Rawat. A journey from a Himalayan village to an American kitchen. Available on Amazon Kindle and StoryMonk." canonical="https://chefsurendrarawat.com/book" type="book">
  <Header slot="header" />
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Book","name":"The Mountain Kitchen","author":{"@type":"Person","name":"Chef Surendra Singh Rawat"},"description":"A Journey from a Himalayan Village to an American Kitchen","publisher":{"@type":"Organization","name":"StoryMonk International"},"isbn":"B0H7QYVMPX","url":"https://chefsurendrarawat.com/book","image":"https://chefsurendrarawat.com/images/book/poster-1.jpg","offers":[{"@type":"Offer","url":"https://www.amazon.com/dp/B0H7QYVMPX","availability":"https://schema.org/InStock","priceCurrency":"USD"},{"@type":"Offer","url":"https://www.amazon.in/dp/B0H7QYVMPX","availability":"https://schema.org/InStock","priceCurrency":"INR"},{"@type":"Offer","url":"https://storymonk.co/store/product/the-mountain-kitchen/","availability":"https://schema.org/InStock"}]})} />
  </Fragment>

  <!-- Hero with poster background -->
  <section class="relative min-h-[70vh] flex items-center overflow-hidden">
    <img src="/the-mountain-kitchen-banner.webp" alt="The Mountain Kitchen Book" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
    <div class="liquid-blob w-[400px] h-[400px] bg-gold-accent/20 -top-20 -right-20" style="animation-delay:0s;"></div>
    <div class="relative container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 md:py-32">
      <div class="max-w-2xl space-y-6 animate-fade-in-up">
        <span class="glass-pill text-gold-accent text-sm font-bold">Now Available</span>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight">The Mountain Kitchen</h1>
        <p class="text-xl md:text-2xl text-white/90 font-light italic">A Journey from a Himalayan Village to an American Kitchen</p>
        <p class="text-base text-white/70">by Chef Surendra Singh Rawat</p>
        <div class="flex flex-wrap gap-4 pt-4">
          {buyLinks.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r ${link.color} text-white font-semibold rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all`}>
              <span>{link.icon}</span>
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Book Posters Gallery -->
  <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-[#1a0a00] to-slate-900">
    <div class="container mx-auto max-w-6xl">
      <div class="text-center mb-12 reveal">
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-gold-accent">Book Gallery</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {posters.map((p, i) => (
          <div class="group relative rounded-2xl overflow-hidden shadow-2xl ring-1 ring-gold-accent/20 cursor-pointer" data-lightbox-trigger>
            <img src={p} alt={`The Mountain Kitchen - Poster ${i+1}`} class="w-full aspect-[3/4] object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" data-lightbox />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About the Book -->
  <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-5xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6 reveal">
          <span class="text-sm font-bold text-mountain-teal uppercase tracking-wider">About the Book</span>
          <h2 class="font-serif text-3xl md:text-4xl font-bold text-himalayan-blue">A Story of Heritage & Flavor</h2>
          <p class="text-lg text-slate-700 leading-relaxed">From the remote mountain villages of Uttarakhand to the bustling kitchens of Chicago — this is the inspiring story of how one chef carried the flavors, traditions, and soul of the Himalayas across continents.</p>
          <p class="text-slate-700 leading-relaxed">Featuring authentic Himalayan recipes, personal stories of resilience, cultural heritage insights, and the professional journey from The Oberoi Group to executive chef at India Palace Restaurant.</p>
          <div class="grid grid-cols-2 gap-4 pt-4">
            <div class="glass-card rounded-xl p-4 text-center">
              <p class="text-2xl font-bold text-himalayan-blue">50+</p>
              <p class="text-xs text-slate-600">Authentic Recipes</p>
            </div>
            <div class="glass-card rounded-xl p-4 text-center">
              <p class="text-2xl font-bold text-himalayan-blue">16+</p>
              <p class="text-xs text-slate-600">Years of Stories</p>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="liquid-blob w-[300px] h-[300px] bg-gold-accent/20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
          <img src="/images/book/poster-2.jpg" alt="The Mountain Kitchen Book Cover" class="relative w-full max-w-sm mx-auto rounded-2xl shadow-2xl ring-2 ring-gold-accent/20 cursor-pointer" loading="lazy" data-lightbox />
        </div>
      </div>
    </div>
  </section>

  <!-- Press -->
  <section class="py-16 px-4 bg-sky-50">
    <div class="container mx-auto max-w-3xl text-center space-y-6 reveal">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-himalayan-blue">In the Press</h2>
      <blockquote class="glass-card rounded-2xl p-8 text-lg text-slate-700 italic leading-relaxed">
        "Chef Surendra Singh Rawat reveals debut book on Himalayan cuisine — bringing authentic mountain flavors and personal stories to readers worldwide."
      </blockquote>
      <a href="https://www.bwhotelier.com/article/chef-surendra-singh-rawat-reveals-debut-book-on-himalayan-cuisine-615589" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-himalayan-blue font-semibold hover:text-gold-accent transition-colors">
        Read on BW Hotelier
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </section>

  <!-- Buy CTA -->
  <section class="py-16 md:py-24 px-4 bg-gradient-to-br from-[#1a0a00] via-[#2d1810] to-[#1a0a00] text-center relative overflow-hidden">
    <div class="liquid-blob w-[500px] h-[500px] bg-gold-accent/10 top-0 right-0" style="animation-delay:2s;"></div>
    <div class="container mx-auto max-w-3xl relative z-10 space-y-8">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-gold-accent">Get Your Copy Today</h2>
      <p class="text-lg text-white/70">Available in Kindle and print editions worldwide.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        {buyLinks.map(link => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r ${link.color} text-white font-semibold rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all`}>
            <span class="text-lg">{link.icon}</span>
            {link.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" settings={settings} />
</Layout>
