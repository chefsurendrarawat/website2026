        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <div class="p-8 text-center space-y-6">
        <div class="w-24 h-24 mx-auto rounded-full overflow-hidden border-4 border-[#0066FF] shadow-xl">
          <img src="/images/design-mode/IMG_8120.JPG.jpeg" alt="Chef Surendra Rawat" class="w-full h-full object-cover" width="96" height="96" />
        </div>
        <div class="space-y-2">
          <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#0066FF]">Follow My Culinary Journey</h3>
          <p class="text-gray-700">Get exclusive recipes, cooking tips, and behind-the-scenes content from my kitchen</p>
        </div>
        <div class="flex flex-col gap-3">
