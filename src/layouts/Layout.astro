<body class="bg-white text-gray-900 overflow-x-hidden">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div class="scroll-progress"></div>
  <slot />

  <!-- Social Follow Popup -->
  <div id="social-popup" class="fixed inset-0 z-[99999] hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="popup-backdrop"></div>
    <div class="relative max-w-md w-full bg-gradient-to-br from-white to-blue-50 rounded-2xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="popup-card">
