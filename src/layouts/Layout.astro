---
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  canonical?: string
  image?: string
  type?: string
}

const {
  title = "Chef Surendra Rawat | Executive Chef Chicago - Himalayan Cuisine",
  description = "Chef Surendra Rawat - Executive Chef at India Palace Restaurant, Wheaton IL. Award-winning Himalayan, Indian & Nepalese cuisine. ACF member, 16+ years experience.",
  canonical = "https://chefsurendrarawat.com",
  image = "https://chefsurendrarawat.com/chef-surendra-rawat-hero.jpg",
  type = "website"
} = Astro.props

const currentPath = Astro.url.pathname
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/jpeg" sizes="192x192" href="/icon-192.jpg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.jpg" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="theme-color" content="#0066FF" />
  <meta name="author" content="Chef Surendra Rawat" />
  <meta name="geo.region" content="US-IL" />
  <meta name="geo.placename" content="Wheaton, Illinois" />
  <meta name="geo.position" content="41.8661;-88.1070" />
  <meta name="keywords" content="Chef Surendra Rawat, Executive Chef Chicago, Himalayan Cuisine, India Palace Restaurant, ACF Chef, private chef Chicago, catering Wheaton IL" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Chef Surendra Rawat" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:creator" content="@ChefSurendraRawat" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://chefsurendrarawat.com/#person",
    "name": "Chef Surendra Rawat",
    "jobTitle": "Executive Chef",
    "url": "https://chefsurendrarawat.com",
    "image": "https://chefsurendrarawat.com/chef-surendra-rawat-hero.jpg",
    "sameAs": ["https://www.instagram.com/surendrasinghrawat91","https://www.youtube.com/@ChefSurendraRawat","https://www.linkedin.com/in/surendra-rawat-834455129","https://www.facebook.com/share/1AHqjGcMYF","https://medium.com/@chefsurendrarawat"],
    "worksFor": {"@type":"Restaurant","name":"India Palace Restaurant","address":{"@type":"PostalAddress","streetAddress":"242 E Geneva Rd","addressLocality":"Wheaton","addressRegion":"IL","postalCode":"60187","addressCountry":"US"},"telephone":"+1-224-261-5963"},
    "memberOf": [{"@type":"Organization","name":"American Culinary Federation"},{"@type":"Organization","name":"Indian Culinary Forum"},{"@type":"Organization","name":"Chefs Guild of India"}],
    "knowsAbout": ["Himalayan Cuisine","Indian Cuisine","Nepalese Cuisine","French Patisserie","Vegetarian Cooking"],
    "award": ["ACF Bronze Medal 2026","Marquis Who's Who Honored Listee","ServSafe Certified"]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": "https://chefsurendrarawat.com",
    "name": "Chef Surendra Rawat",
    "inLanguage": "en-US",
    "publisher": {"@id":"https://chefsurendrarawat.com/#person"}
  })} />
  <slot name="head" />
</head>
<body class="bg-white text-gray-900 overflow-x-hidden font-sans">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div class="scroll-progress"></div>
  <slot name="header" />
  <main id="main-content">
    <slot />
  </main>
  <slot name="footer" />
  <!-- Image Lightbox -->
  <div class="lightbox-overlay" id="lightbox">
    <button class="absolute top-4 right-4 w-10 h-10 rounded-full glass flex items-center justify-center text-white hover:scale-110 transition-transform" id="lightbox-close" aria-label="Close">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <img id="lightbox-img" src="" alt="" />
  </div>

  <script>
    import { inject } from '@vercel/analytics';
    import { injectSpeedInsights } from '@vercel/speed-insights';
    inject();
    injectSpeedInsights();

    // IntersectionObserver for reveals
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));

    // Image lightbox
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    document.querySelectorAll('[data-lightbox]').forEach(img => {
      img.addEventListener('click', () => {
        const src = (img as HTMLImageElement).src || img.getAttribute('data-lightbox');
        if (src && lightboxImg && lightbox) {
          lightboxImg.src = src;
          lightboxImg.alt = (img as HTMLImageElement).alt || '';
          lightbox.classList.add('active');
        }
      });
    });
    document.getElementById('lightbox-close')?.addEventListener('click', () => lightbox?.classList.remove('active'));
    lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.classList.remove('active'); });
  </script>
</body>
</html>
